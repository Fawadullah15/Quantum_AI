# PostgreSQL Database Connection (Required)
# Format: postgresql://user:password@host:port/database
# For Vercel Postgres, use the connection string from Vercel dashboard
DATABASE_URL=""

# NextAuth Configuration (Required)
# Set this to your production domain URL
NEXTAUTH_URL=""
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Vercel Blob Token (Required for image uploads)
# Get this from Vercel Blob storage dashboard
BLOB_READ_WRITE_TOKEN=""
