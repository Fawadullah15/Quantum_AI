# Vercel Postgres Connection (Required for Vercel)
DATABASE_URL="postgresql://postgres:password@localhost:5432/quantum_ai"

# NextAuth Configuration (Required)
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Vercel Blob Token (Required for image uploads)
BLOB_READ_WRITE_TOKEN="your-blob-token-here"

# ─────────────────────────────────────────────────────────────
# Email Delivery Configuration (Recipient: quantumai.cmp@gmail.com)
# ─────────────────────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL="quantumai.cmp@gmail.com"

# Option A: Gmail SMTP with App Password (Recommended for Gmail)
GMAIL_USER="quantumai.cmp@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-google-app-password"

# Option B: Generic SMTP Server
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="quantumai.cmp@gmail.com"
# SMTP_PASS="your-password"
# SMTP_SECURE="true"

# Option C: Resend API
# RESEND_API_KEY="re_123456789"
