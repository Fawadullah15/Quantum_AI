# =============================================================================
# QUANTUM AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local containing real credentials to Git!
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT:
# Point to your dedicated local PostgreSQL instance.
# Recommended database name: quantum_ai_dev (keeps development completely isolated).
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/quantum_ai_dev"

# PRODUCTION (Neon PostgreSQL on Vercel):
# Set this in your Vercel Project Settings > Environment Variables:
# DATABASE_URL="postgresql://[user]:[password]@[ep-xyz]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# 2. AUTHENTICATION (NextAuth.js)
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT:
NEXTAUTH_URL="http://localhost:3000"

# PRODUCTION (Vercel):
# NEXTAUTH_URL="https://quantum-ai.vercel.app"

# Strong secret for encrypting NextAuth session JWTs (Minimum 32 characters)
# Generate via terminal: openssl rand -base64 32
NEXTAUTH_SECRET="your-secure-random-32-character-secret-key-here"

# ─────────────────────────────────────────────────────────────────────────────
# 3. CLOUD FILE STORAGE (Vercel Blob)
# ─────────────────────────────────────────────────────────────────────────────
# Optional in local development (falls back safely to local .private_storage)
# Required in production on Vercel for public uploads and database backups
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# ─────────────────────────────────────────────────────────────────────────────
# 4. EMAIL NOTIFICATIONS (Admin Submission Alerts)
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL="quantumai.cmp@gmail.com"

# Option A: Gmail SMTP with Google App Password (Recommended)
GMAIL_USER="quantumai.cmp@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-google-app-password"

# Option B: Generic SMTP Server (Optional fallback)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="quantumai.cmp@gmail.com"
# SMTP_PASS="your-password"
# SMTP_SECURE="true"

# Option C: Resend API (Optional fallback)
# RESEND_API_KEY="re_123456789"
