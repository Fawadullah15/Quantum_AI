generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite does not support native enums.
// Enum-like fields use String with application-level validation.

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  password     String
  role         String        @default("EDITOR") // SUPER_ADMIN | ADMIN | EDITOR
  tokenVersion Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id       String  @id @default(cuid())
  label    String
  href     String
  order    Int     @default(0)
  external Boolean @default(false)
}

// Legacy model kept for migration compatibility
model Founder {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  photo     String?
  linkedin  String?
  twitter   String?
  github    String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  photo     String?
  linkedin  String?
  twitter   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Full Leadership Directory
model Leadership {
  id           String   @id @default(cuid())
  publicId     String   @unique // e.g. "QA-001"
  slug         String   @unique // e.g. "muhammad-murtaza"
  name         String
  // Position: CEO | CTO | CHAIRMAN | COO | CFO | DIRECTOR | LEAD_ENGINEER | RESEARCHER | ADVISOR | OTHER
  position     String
  roleType     String   @default("PREDEFINED") // PREDEFINED | CUSTOM
  customRole   String?
  department   String?
  shortBio     String
  fullBio      String?
  photo        String?
  email        String?
  linkedin     String?
  github       String?
  website      String?
  location     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String
  category     String
  status       String           @default("IN_DEVELOPMENT") // LIVE | BETA | IN_DEVELOPMENT | PLANNED
  heroImage    String?
  demoUrl      String?
  docsUrl      String?
  features     ProductFeature[]
  technologies String
  published    Boolean          @default(false)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProductFeature {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int     @default(0)
}

model CaseStudy {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  client         String
  industry       String
  problem        String
  solution       String
  implementation String
  technologies   String
  results        String
  year           Int
  services       String
  heroImage      String?
  gallery        String            @default("[]") // JSON string array of image URLs
  externalUrl    String?
  metrics        CaseStudyMetric[]
  published      Boolean           @default(false)
  order          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model CaseStudyMetric {
  id          String    @id @default(cuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  label       String
  value       String
  description String?
}

model Service {
  id          String   @id @default(cuid())
  name        String
  category    String   // AI | SOFTWARE | PRODUCT | CONSULTING
  description String
  icon        String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Technology {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  category         String   // AI/ML | Frontend | Backend | Database | Infrastructure | DevOps | API | Other
  heroTitle        String?
  heroDescription  String?
  heroImage        String?
  content          String?  // Rich text content for the page
  features         String?  @default("[]") // JSON array of feature objects
  useCases         String?  @default("[]") // JSON array of use case objects
  ctaTitle         String?
  ctaDescription   String?
  ctaText          String?
  ctaLink          String?
  usage            String?
  projects         String?
  icon             String?
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  category    String?
  tags        String    @default("[]") // JSON array
  author      String
  published   Boolean   @default(false)
  publishedAt DateTime?
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String?
  role      String?
  content   String
  rating    Int      @default(5)
  photo     String?
  published Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  logo        String?
  website     String?
  industry    String?
  description String?
  featured    Boolean  @default(true)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  projectType String?
  budget      String?
  message     String
  status      String   @default("NEW") // NEW | CONTACTED | IN_PROGRESS | CLOSED | ARCHIVED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  type      String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// CAREERS & BUSINESS PARTNERSHIPS
// ─────────────────────────────────────────────────────────────

model CareerApplication {
  id                String           @id @default(cuid())
  referenceId       String           @unique // e.g. "QA-CAR-1001"
  fullName          String
  email             String
  phone             String?
  currentLocation   String?
  photoUrl          String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  position          String
  experienceLevel   String           // Student | Entry Level | Junior | Mid Level | Senior | Lead
  skills            String
  introduction      String
  whyQuantumAI      String?
  resumeUrl         String           // Secure file path/blob
  additionalDocsUrl String?
  workType          String           // Full Time | Part Time | Internship | Freelance | Contract | Remote
  status            String           @default("NEW") // NEW | REVIEWING | SHORTLISTED | CONTACTED | INTERVIEW | ACCEPTED | REJECTED | CLOSED
  assignedTo        String?
  notes             SubmissionNote[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model PartnershipRequest {
  id                     String           @id @default(cuid())
  referenceId            String           @unique // e.g. "QA-PTR-2001"
  fullName               String
  company                String?
  email                  String
  phone                  String?
  website                String?
  country                String?
  partnershipType        String           // Technology Partnership | Business Partnership | Strategic Partnership | Marketing Partnership | Investment | Outsourcing | Other
  subject                String
  message                String
  budgetRange            String?
  preferredContactMethod String?          // Email | Phone | WhatsApp | Video Call
  attachmentUrl          String?
  status                 String           @default("NEW") // NEW | REVIEWING | SHORTLISTED | CONTACTED | INTERVIEW | ACCEPTED | REJECTED | CLOSED
  assignedTo             String?
  notes                  SubmissionNote[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model CareerPosition {
  id          String   @id @default(cuid())
  title       String   @unique
  department  String   @default("AI Engineering") // AI Engineering | Software | Infrastructure | Product | Operations
  location    String   @default("Remote / Hybrid")
  workType    String   @default("Full Time")
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubmissionNote {
  id                   String              @id @default(cuid())
  careerApplicationId  String?
  careerApplication    CareerApplication?  @relation(fields: [careerApplicationId], references: [id], onDelete: Cascade)
  partnershipRequestId String?
  partnershipRequest   PartnershipRequest? @relation(fields: [partnershipRequestId], references: [id], onDelete: Cascade)
  authorName           String
  authorEmail          String
  content              String
  createdAt            DateTime            @default(now())
}

